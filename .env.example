# Pick ONE provider. If both keys are set, Anthropic is used unless you
# override with LLM_PROVIDER.
# LLM_PROVIDER=anthropic   # or: openrouter

# --- Option A: Anthropic (native) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Option B: OpenRouter (openrouter.ai) — has free-tier models ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: point the browser fallback at a real Chrome profile directory
# instead of the project-local one. Chrome must be closed first — it locks
# its profile directory and refuses concurrent access.
# CHROME_PROFILE_DIR=/home/you/.config/google-chrome/Default
